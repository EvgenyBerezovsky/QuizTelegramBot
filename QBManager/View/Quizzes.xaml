<UserControl x:Class="QBManager.View.Quizzes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QBManager.ViewModel" 
             xmlns:local="clr-namespace:QBManager.Utilities"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="622"
             Style="{StaticResource Page_Style}">



    <UserControl.DataContext>
        <vm:QuizVM />
    </UserControl.DataContext>

    <Grid Margin="15">

        <Border CornerRadius="20,20,20,20"
                 BorderThickness="0">
            <Border.Background>
                <ImageBrush ImageSource="/Images/quizzes_page.png"
                            Stretch="None" />
            </Border.Background>


        </Border>

        <Grid Margin="20, 90, 20 , 20">
            <!-- Сетка для разделения списка викторин и деталей -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <!-- Список викторин -->
                <ColumnDefinition Width="*"/>
                <!-- Разделитель -->
                <ColumnDefinition Width="300"/>
                <!-- Детали выбранной викторины -->
            </Grid.ColumnDefinitions>

            <!-- Список викторин -->
            <Border Grid.Column="0" 
                    Background="#272B2F" 
 
                    BorderThickness="0">

                <ListBox ItemsSource="{Binding Quizzes, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                         SelectedItem="{Binding SelectedQuiz}" 
                         Background="Transparent" 
                         Foreground="#bdbdbe"
                         BorderThickness="0" 
                         ItemContainerStyle="{StaticResource ListBoxItemStyle}" 
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">


                    <ListBox.ContextMenu  >
                        <ContextMenu Style="{StaticResource ContextMenuStyle}">

                            <MenuItem Header="Add new quiz"
                                      Command="{Binding AddQuizCommand}"
                                      Foreground="#bdbdbe"
                                      Style="{StaticResource MenuItemStyle}"/>

                            <MenuItem Header="Edit quiz"
                                      Command="{Binding EditQuizCommand}"
                                      Style="{StaticResource MenuItemStyle}"
                                      Foreground="#bdbdbe"/>
                           
                            <MenuItem Header="Delete quiz"
                                      Command="{Binding DeleteQuizCommand}"
                                      Style="{StaticResource MenuItemStyle}"
                                      Foreground="#bdbdbe"/>
                            
                        </ContextMenu>
                    </ListBox.ContextMenu>







                    <ListBox.ItemTemplate>
                        <DataTemplate>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              IsChecked="{Binding IsActive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Command="{Binding ChangeCheckedCommand}"
                                              CommandParameter="{Binding IsChecked, RelativeSource={RelativeSource Self}}"/>
                                <TextBlock Grid.Column="1"
                                               HorizontalAlignment="Left"
                                               Text="{Binding Topic}" 
                                               FontSize="16" 
                                               Foreground="#bdbdbe" 
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               Style="{StaticResource TextQuiz_Style}"/>
                            </Grid>

                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </Border>




            <!-- Детали выбранной викторины -->
            <Border Grid.Column="2" 
                    Background="#272B2F" 

                    BorderThickness="0" >
                



                    <!-- Список вопросов -->

                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Height="450"
                                 >
                        <ItemsControl ItemsSource="{Binding Questions}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#272B2F"  
                                            Padding="10" 
                                            Margin="0,5,0,5" 
                                            BorderBrush="#bdbdbe" 
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Question}"
                                                       Style="{StaticResource TextQuiz_Style}"
                                                       FontSize="16" 
                                                       TextWrapping="Wrap" 
                                                       
                                                       Foreground="#bdbdbe" 
                                                       Margin="0,0,0,15"/>
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding}" 
                                                                   Style="{StaticResource TextQuiz_Style}"
                                                                   FontSize="14" 
                                                                   Foreground="#bdbdbe" 
                                                                   Margin="15,0,0,0"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding Answer}" 
                                                       Style="{StaticResource TextQuiz_Style}"
                                                       FontSize="16" 
                                                       TextWrapping="Wrap" 
                                                     
                                                       Foreground="#bdbdbe"
                                                       Margin="0,15,0,5"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
               
            </Border>
        </Grid>


    </Grid>
</UserControl>
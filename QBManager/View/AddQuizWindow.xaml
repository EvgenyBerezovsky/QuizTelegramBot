<Window x:Class="QBManager.View.AddQuizWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QBManager.View"
        mc:Ignorable="d"
        Title="Add new quiz" 
        Height="640" 
        Width="840"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        Background="Transparent">
    <Grid Margin="10">
       
        <Grid Background="#272B2F" >
            <Border BorderBrush="#bdbdbe" 
                    BorderThickness="5" 
                    Background="#272B2F"
                    CornerRadius="20">
            </Border>

            <Grid Margin="20, 40, 20, 20">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="385"/>

                    <!-- Разделитель -->
                    <ColumnDefinition Width="10"/>

                    <ColumnDefinition Width="385"/>

                </Grid.ColumnDefinitions>


                <Border Grid.Column="0" 
                    Background="#272B2F" 
                    BorderThickness="0">



                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>


                        <!--Quiz topic field-->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="2" 
                                BorderBrush="#bdbdbe"
                                BorderThickness="1" >

                            </Border>

                            <TextBlock Grid.Column="0"
                                   Text="Quiz topic:" 
                                   Foreground="#bdbdbe" 
                                   FontSize="16" 
                                   HorizontalAlignment="Left"
                                   Margin="5"
                                   Style="{StaticResource TextQuiz_Style}">
                            </TextBlock>

                            <TextBox Grid.Column="1" 
                                         x:Name="txtTopic"
                                         FontSize="16"
                                         Margin="5">
                            </TextBox>
                        </Grid>

                        <Grid Grid.Row="1" Margin="5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Quiz is active (available in telegramm bot):"
                                           Foreground="#bdbdbe" 
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           FontSize="16"
                                           Margin="0, 5, 5, 5"
                                           Style="{StaticResource TextQuiz_Style}"/>

                            <CheckBox Grid.Column="1"   
                                          x:Name="chkIsActive" 
                                          Margin="5"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="Right"/>
                        </Grid>



                        <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                  Height="420"
                                  Grid.Row ="2">


                            <Grid Grid.Row="0">
                                <GroupBox Header="Add new or edit question" 
                                          FontSize="16" 
                                          Foreground="#bdbdbe"
                                          Margin="5">
                                    <Grid Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" 
                                                   Text="Question text:" 
                                                   Foreground="#bdbdbe"
                                                   FontSize="14" 
                                                   Margin="5"/>
                                        <TextBox   Grid.Row="1"  
                                                   TextWrapping="Wrap"
                                                   x:Name="txtNewQuestion" 
                                                   Margin="0,0,0,5"/>

                                        <StackPanel Grid.Row="2" 
                                            Margin="0,0,0,5">
                                            <TextBlock Text="Answer option 1:" FontSize="12" Margin="0,5,0,2"/>
                                            <TextBox x:Name="txtOption1" TextWrapping="Wrap" Height="25" Margin="0,0,0,5"/>

                                            <TextBlock Text="Answer option 2:" FontSize="12" Margin="0,5,0,2"/>
                                            <TextBox x:Name="txtOption2" Height="25" Margin="0,0,0,5"/>

                                            <TextBlock Text="Answer option 3:" FontSize="12" Margin="0,5,0,2"/>
                                            <TextBox x:Name="txtOption3" TextWrapping="Wrap" Height="25" Margin="0,0,0,5"/>

                                            <TextBlock Text="Answer option 4:" FontSize="12" Margin="0,5,0,2"/>
                                            <TextBox x:Name="txtOption4" Height="25" TextWrapping="Wrap" Margin="0,0,0,5"/>


                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Correct answer:" FontSize="14" Margin="0,5,0,2"/>
                                            <TextBox  Grid.Row="2" Grid.Column="1" TextWrapping="Wrap" x:Name="txtNewAnswer" 
                                                  Height="25" Margin="0,0,0,5"/>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </Grid>
                        </ScrollViewer>

                        <Grid Grid.Row="3" >
                            <Button Height="30"
                                Width="100"
                                Click="AddQuestion_Click" 
                                HorizontalAlignment="Left"
                                Margin="10"
                                Style="{StaticResource AddSaveBtnStyle}">

                                <Grid>
                                    <TextBlock Text="Add question"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           Style="{StaticResource TextQuiz_Style}">
                                    </TextBlock>
                                </Grid>
                            </Button>
                        </Grid>

                    </Grid>
                </Border>




                <!-- Детали добавляемой викторины -->
                <Border Grid.Column="2" 
                    Background="#272B2F" 
                    BorderThickness="0" >


                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <GroupBox Grid.Row="0"
                                  Header="Quiz questions" 
                                  FontSize="16" 
                                  Foreground="#bdbdbe"
                                  Margin="5, 0, 5, 0" 
                                  Height="487">

                            <ListBox 
                                  ItemsSource="{Binding Questions, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                  SelectedItem="{Binding SelectedQuestion, Mode=TwoWay,UpdateSourceTrigger=PropertyChanged}" 
                                  Background="Transparent" 
                                  Foreground="#bdbdbe"
                                  BorderThickness="0" 
                                  ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                                  ScrollViewer.CanContentScroll="False"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled" >

                                <ListBox.ContextMenu  >
                                    <ContextMenu Style="{StaticResource ContextMenuStyle}">

                                        <MenuItem Header="Edit question"
                                              Command="{Binding EditQuestionCommand}"
                                              Foreground="#bdbdbe"
                                              Style="{StaticResource MenuItemStyle}"/>

                                        <MenuItem Header="Delete question"
                                              Command="{Binding DeleteQuestionCommand}"
                                              Style="{StaticResource MenuItemStyle}"
                                              Foreground="#bdbdbe"/>



                                    </ContextMenu>
                                </ListBox.ContextMenu>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#272B2F"  
                                                Padding="10" 
                                                Margin="5" 
                                                BorderBrush="#bdbdbe" 
                                                BorderThickness="1">
                                            <StackPanel>


                                                <TextBlock Text="{Binding Question}"
                                                       Style="{StaticResource TextQuiz_Style}"
                                                       FontSize="16" 
                                                       TextWrapping="Wrap" 
                                                       Foreground="#bdbdbe" 
                                                       Margin="0,0,0,15"/>
                                                <ItemsControl ItemsSource="{Binding Options}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding}" 
                                                                   Style="{StaticResource TextQuiz_Style}"
                                                                   FontSize="14" 
                                                                   Foreground="#bdbdbe" 
                                                                   Margin="15,0,0,0"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Text="{Binding Answer}" 
                                                       Style="{StaticResource TextQuiz_Style}"
                                                       FontSize="16" 
                                                       TextWrapping="Wrap" 
                                                     
                                                       Foreground="#bdbdbe"
                                                       Margin="0,15,0,5"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </GroupBox>

                        <Button Grid.Row="1"
                            Height="30"
                            Width="100" 
                            HorizontalAlignment="Left"
                            Margin="10"
                            Click="SaveQuiz_Click"
                            Style="{StaticResource AddSaveBtnStyle}">

                            <Grid>
                                <TextBlock Text="Save quiz"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           Style="{StaticResource TextQuiz_Style}">
                                </TextBlock>
                            </Grid>


                        </Button>






                    </Grid>


                    <!-- Список вопросов -->







                </Border>
            </Grid>



        </Grid>

        <Button x:Name="CloseApp"
                Style="{StaticResource ExitWindow}"
                Click="CloseWin_Click" RenderTransformOrigin="0.5,0" Grid.ColumnSpan="2" />

    </Grid>
</Window>
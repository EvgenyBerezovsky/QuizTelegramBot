<UserControl x:Class="QBManager.View.AddNewQuizzes"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QBManager.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="622"
             Style="{StaticResource Page_Style}">

    <UserControl.DataContext>
        <vm:NewQuizVM />
    </UserControl.DataContext>

    <Grid Margin="15">

        <Border CornerRadius="20,20,20,20"
                BorderThickness="0">
            <Border.Background>
                <ImageBrush ImageSource="/Images/AddNewQuiz_page.png"
                            Stretch="None" />
            </Border.Background>
        </Border>

        <Grid Margin="20, 85, 20 , 0">
            <!-- Сетка для разделения списка викторин и деталей -->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <!-- Список викторин -->
                <ColumnDefinition Width="*"/>
                <!-- Разделитель -->
                <ColumnDefinition Width="300"/>
                <!-- Детали выбранной викторины -->
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" 
                    Background="#272B2F" 
                    BorderThickness="0" 
                    
                    Margin="0,0,0,20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>

                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0"
                                  VerticalScrollBarVisibility="Auto"
                                   Height="421">
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>

                            </Grid.RowDefinitions>





                            <Grid Grid.Row="0" Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="2" 
                                BorderBrush="#bdbdbe"
                                BorderThickness="1" >

                                </Border>

                                <TextBlock Grid.Column="0"
                                   Text="Quiz topic:" 
                                   Foreground="#bdbdbe" 
                                   FontSize="16" 
                                   HorizontalAlignment="Left"
                                   Margin="5"
                                   Style="{StaticResource TextQuiz_Style}">
                                </TextBlock>

                                <TextBox Grid.Column="1" 
                                         x:Name="txtTopic"
                                         Text="{Binding NewQuiz.Topic}"
                                         FontSize="16"
                                         TextWrapping="Wrap"
                                         Margin="5">
                                </TextBox>
                            </Grid>

                            <Grid Grid.Row="1" Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="26"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="2" 
                                BorderBrush="#bdbdbe"
                                BorderThickness="1" >

                                </Border>

                                <TextBlock Text="Quiz is published :"
                                           Foreground="#bdbdbe" 
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           FontSize="16"
                                           Margin="5"
                                           Style="{StaticResource TextQuiz_Style}"/>

                                <CheckBox Grid.Column="1"   
                                  x:Name="chkIsActive" 
                                  IsChecked="{Binding NewQuiz.IsPublished}"
                                  Margin="5"
                                  VerticalAlignment="Center"
                                  HorizontalAlignment="Right"/>
                            </Grid>





                            <Grid Grid.Row="2">

                                <GroupBox Header="Questions"
                                  FontSize="16" 
                                  Foreground="#bdbdbe"
                                  Margin="0">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          Height="310">
                                        <ItemsControl ItemsSource="{Binding Questions}"
                                              Name="dgQuestions">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#272B2F"  
                                                    Padding="10" 
                                                    Margin="5" 
                                                    BorderBrush="#bdbdbe" 
                                                    BorderThickness="1">
                                                        <StackPanel>


                                                            <TextBlock Text="{Binding Question}"
                                                               Style="{StaticResource TextQuiz_Style}"
                                                               FontSize="16" 
                                                               TextWrapping="Wrap" 
                                                               Foreground="#bdbdbe" 
                                                               Margin="0,0,0,15"/>

                                                            <ItemsControl ItemsSource="{Binding Options}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding}" 
                                                                           Style="{StaticResource TextQuiz_Style}"
                                                                           FontSize="14" 
                                                                           Foreground="#bdbdbe" 
                                                                           Margin="15,0,0,0"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding Answer}" 
                                                               Style="{StaticResource TextQuiz_Style}"
                                                               FontSize="16" 
                                                               TextWrapping="Wrap" 
                                                               Foreground="#bdbdbe"
                                                               Margin="0,15,0,5"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </GroupBox>
                            </Grid>
                        </Grid>
                        
                    </ScrollViewer>




                    <Button Grid.Row="4"
                            Foreground="#bdbdbe"
                            Command="{Binding SaveQuizCommand}"
                            HorizontalAlignment="Left"
                            Margin="0, 10, 0, 0"
                            Style="{StaticResource AddSaveBtnStyle}">


                        <Grid>
                            <TextBlock Text="Save quiz"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       Style="{StaticResource TextQuiz_Style}">

                            </TextBlock>
                        </Grid>
                    </Button>
                </Grid>
            </Border>



            <Border Grid.Column="2"
                    Background="#272B2F" 
                    BorderThickness="0" Margin="0,0,0,20">

                <Grid Margin="0,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height ="Auto"/>
                        <RowDefinition Height ="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      Grid.Row="0"
                                      Height="420"
                                      VerticalAlignment="Top">

                            <GroupBox Header="New quastion" 
                                      FontSize="16" 
                                      Foreground="#bdbdbe"
                                      Margin="0">
                                <Grid Margin="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" 
                                               Text="Question text:" 
                                               Foreground="#bdbdbe"
                                               FontSize="14" 
                                               Margin="0,5,0,2" />


                                    <Border Grid.Row="1" 
                                            BorderBrush="#bdbdbe"
                                            BorderThickness="1">

                                        <TextBox   Grid.Row="1"  
                                               TextWrapping="Wrap"
                                               x:Name="txtNewQuestion" 
                                               Text="{Binding Question.Question}"
                                               Margin="5,5,5,5"/>
                                    </Border>




                                    <StackPanel Grid.Row="2" 
                                                Margin="0,0,0,5">

                                        <TextBlock Text="Answer option 1:" 
                                                   FontSize="12" 
                                                   Margin="0,5,0,2"/>
                                        <Border Grid.Row="1" 
                                                BorderBrush="#bdbdbe"
                                                BorderThickness="1">
                                            <TextBox x:Name="txtOption1"
                                                     Text="{Binding Question.Options[0]}"
                                                     TextWrapping="Wrap"  
                                                     Margin="5,5,5,5"/>
                                        </Border>


                                        <TextBlock Text="Answer option 2:" 
                                                   FontSize="12" 
                                                   Margin="0,5,0,2"/>
                                        <Border Grid.Row="1" 
                                                BorderBrush="#bdbdbe"
                                                BorderThickness="1">
                                            <TextBox x:Name="txtOption2" 
                                                     Text="{Binding Question.Options[1]}"
                                                     Height="25" 
                                                     Margin="5,5,5,5"/>
                                        </Border>


                                        <TextBlock Text="Answer option 3:" 
                                                   FontSize="12" 
                                                   Margin="0,5,0,2"/>
                                        <Border Grid.Row="1" 
                                                BorderBrush="#bdbdbe"
                                                BorderThickness="1">
                                            <TextBox x:Name="txtOption3"
                                                     Text="{Binding Question.Options[2]}"
                                                     TextWrapping="Wrap"  
                                                     Margin="5,5,5,5"/>
                                        </Border>


                                        <TextBlock Text="Answer option 4:" 
                                                   FontSize="12" 
                                                   Margin="0,5,0,2"/>
                                        <Border Grid.Row="1" 
                                                BorderBrush="#bdbdbe"
                                                BorderThickness="1">
                                            <TextBox x:Name="txtOption4"  
                                                 Text="{Binding Question.Options[3]}"
                                                 TextWrapping="Wrap" 
                                                 Margin="5,5,5,5"/>
                                        </Border>


                                        <TextBlock Grid.Row="2" 
                                                   Grid.Column="0" 
                                                   Text="Correct answer:" 
                                                   FontSize="14" 
                                                   Margin="0,5,0,2"/>
                                        <Border Grid.Row="1" 
                                                BorderBrush="#bdbdbe"
                                                BorderThickness="1">
                                            <TextBox Grid.Row="2" 
                                                 Grid.Column="1" 
                                                 TextWrapping="Wrap" 
                                                 Text="{Binding Question.Answer}"
                                                 x:Name="txtNewAnswer" 
                                                 Margin="5,5,5,5"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </GroupBox>
                        </ScrollViewer>


                    </Grid>

                    <Grid Grid.Row="1">

                        <Button Height="30"
                                Width="100"
                                Command="{Binding AddQuestionCommand}" 
                                 Style="{StaticResource AddSaveBtnStyle}"
                                HorizontalAlignment="Left"
                                Margin="0, 10, 0, 0">

                            <Grid>

                                <TextBlock Text="Add question"
                                       VerticalAlignment="Top"
                                       HorizontalAlignment="Center"
                                       FontSize="14"
                                       Style="{StaticResource TextQuiz_Style}" >

                                </TextBlock>
                            </Grid>


                        </Button>

                    </Grid>

                </Grid>



            </Border>



        </Grid>
    </Grid>
</UserControl>

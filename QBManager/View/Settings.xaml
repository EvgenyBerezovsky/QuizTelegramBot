<UserControl x:Class="QBManager.View.Settings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:QBManager.ViewModel"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="622"
             Style="{StaticResource Page_Style}">

    <UserControl.DataContext>
        <vm:SettingVM />
    </UserControl.DataContext>

    <Grid Margin="15">

        <Border CornerRadius="0,20,20,0">
            <Border.Background>
                <ImageBrush ImageSource="/Images/setting_page.png"
                            Stretch="None" />
            </Border.Background>
        </Border>

       
        <Grid Margin="20, 120, 20 , 20">
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>

                <RowDefinition Height="10"/>

                <RowDefinition Height="50"/>
                <RowDefinition Height="10"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                       Text="Telegram bot token:" 
                       VerticalAlignment="Center"
                       Foreground="#bdbdbe"
                       FontSize="16" 
                       Margin="0,5,0,2" />


            <Border Grid.Row="2" 
                    BorderBrush="#bdbdbe"
                    BorderThickness="2">

                <TextBox  Grid.Row="2"  
                          TextWrapping="Wrap"
                          Text="{Binding TelegramToken}"
                          VerticalAlignment="Center"
                          FontSize="16"
                          Padding="0,5,5,0"
                          Margin="5,5,5,5"/>
            </Border>

            <Button Grid.Row="4"
                    Foreground="#bdbdbe"
                    Command="{Binding SaveTokenCommand}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="0, 10, 0, 0"
                    Style="{StaticResource AddSaveBtnStyle}">


                <Grid>
                    <TextBlock Text="Save token"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="14"
                               Style="{StaticResource TextQuiz_Style}">

                    </TextBlock>
                </Grid>
            </Button>

        </Grid>

        
    </Grid>
</UserControl>

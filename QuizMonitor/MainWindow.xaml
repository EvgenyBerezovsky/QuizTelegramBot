<Window x:Class="QuizMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QuizMonitor"
        mc:Ignorable="d"
        x:Name="QuizManagment"
        Title="Quiz Management" 
        Height="600" 
        Width="800"
        MinWidth="400"
        MinHeight="400"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <Grid>
        <Border Background="#ed7990"
                CornerRadius="20">
        </Border>

        <DockPanel LastChildFill="True">

            <Grid DockPanel.Dock="Top"    Margin="15"></Grid>

            <Grid DockPanel.Dock="Left" Margin="15,0,15,0">
                <StackPanel Width="150">
                    <Button Content="Start Bot" Margin="10" Padding="5" Height="40" />
                    <Button Content="Quizzes" Margin="10" Padding="5" Height="40" />
                    <Button Content="Users progress" Margin="10" Padding="5" Height="40" />
                    <Button Content="Exit" Margin="10" Padding="5" Height="40" />
                </StackPanel>
            </Grid>


            <Grid DockPanel.Dock="Bottom" Margin="15"></Grid>
            <Grid DockPanel.Dock="Right"  Margin="15"></Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30*"/>
                    <ColumnDefinition Width="70*"/>
                </Grid.ColumnDefinitions>

                <ListView Name="QuizListView"  ItemsSource="{Binding Quizzes}" Margin="10"
                          Grid.Row="0" Grid.Column="0" 
                          SelectionChanged="QuizListView_SelectionChanged">
                    <ListView.View>
                        <GridView>
                            <!-- Заголовок для столбца с CheckBox -->
                            <GridViewColumn Header="Активна">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsActive}" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!-- Заголовок для столбца с названием викторины -->
                            <GridViewColumn Header="Тема" Width="Auto">
                                <GridViewColumn.HeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center" />
                                    </Style>
                                </GridViewColumn.HeaderContainerStyle>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Topic}" 
                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>



                <ListView Name="QuestionsListView" Grid.Row="0" Grid.Column="1" Margin="10"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Stretch">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <!-- Растягивание элементов внутри ListView -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" Margin="5" Padding="10"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    MaxHeight="200" MinHeight="100" Width="400">
                                <!-- Установлены ограничения по размерам -->
                                <StackPanel>
                                    <!-- Текст вопроса с переносом -->
                                    <TextBlock Text="{Binding Question}" FontWeight="Bold" FontSize="14"
                               TextWrapping="Wrap" TextAlignment="Left" />
                                    <!-- Варианты ответов с переносом -->
                                    <StackPanel Orientation="Vertical" Margin="5,0,0,0">
                                        <TextBlock Text="{Binding Options[0]}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Options[1]}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Options[2]}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Options[3]}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <!-- Правильный ответ -->
                                    <TextBlock Text="{Binding CorrectOptionIndex, StringFormat=Right answer index(starting from 0): {0}}" 
                               FontWeight="Bold" Foreground="Green" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

            </Grid>
        </DockPanel>
        <Button HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Width="20"
                        Height="20"
                        Margin="20"
                        Click="CloseApp_Click"
                        Background="Transparent"
                        BorderThickness="0">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" BorderThickness="0">
                        <Image Source="/Images/shutdown_mo.png" Stretch="Uniform" />
                    </Border>
                </ControlTemplate>
            </Button.Template>
        </Button>

    </Grid>

</Window>


